{
  "rules": {
    "couples": {
      "$coupleCode": {
        ".read": true,

        // 신규 방 생성(A): 인증 사용자만, 기존 데이터 없을 때만
        // 파트너 답변 제출(B): 인증 사용자, waiting 상태인 방만 업데이트 가능
        // 완료 후 재수정 불가 (status=completed 이면 잠김)
        ".write": "auth != null && (!data.exists() || data.child('status').val() === 'waiting')",

        ".validate": "newData.hasChildren(['creatorAnswers', 'status', 'createdAt'])",

        "status": {
          // waiting → completed 단방향만 허용
          ".validate": "newData.val() === 'waiting' || (data.val() === 'waiting' && newData.val() === 'completed')"
        },

        "partnerAnswers": {
          // waiting 상태인 동안은 B가 여러 번 쓸 수 있음 (네트워크 재시도 허용)
          // 부모 .write 조건(status=waiting)이 이미 완료 후 잠금을 보장
          ".write": "auth != null && data.parent().child('status').val() === 'waiting'"
        }
      }
    },

    "rooms": {
      "$roomCode": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
