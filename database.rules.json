{
  "rules": {
    "couples": {
      "$coupleCode": {
        ".read": true,

        // A(creator): 인증된 사용자만 새 방 생성 가능 (기존 데이터 없을 때만)
        ".write": "auth != null && (!data.exists() || data.child('status').val() === 'waiting')",

        ".validate": "newData.hasChildren(['creatorAnswers', 'status', 'createdAt'])",

        "status": {
          // waiting → completed 단방향 전환만 허용 (완료 후 되돌리기 불가)
          ".validate": "newData.val() === 'waiting' || (data.val() === 'waiting' && newData.val() === 'completed')"
        },

        "partnerAnswers": {
          // B 답변은 한 번만 쓸 수 있음 (덮어쓰기 불가)
          ".write": "auth != null && !data.exists()"
        }
      }
    },

    "rooms": {
      "$roomCode": {
        ".read": true,
        ".write": "auth != null"
      }
    },

    // 그 외 경로는 읽기·쓰기 모두 차단
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
